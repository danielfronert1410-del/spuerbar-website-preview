# Spürbar Ich sein, Hostinger (LiteSpeed/Apache)
# Redirects + Fehlerseite. Statische Multi-Page-Site.

RewriteEngine On

# www -> non-www (Canonical ist non-www)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NC]

# Alte Wix-URLs -> neue Seiten (301, dauerhaft)
RewriteRule ^stefanie-fronert/?$ /ueber-mich.html [R=301,L,NC]
RewriteRule ^preise/?$ /kontakt.html [R=301,L,NC]
RewriteRule ^kopie-von-hypnose/?$ /hypnose-duesseldorf.html [R=301,L,NC]
RewriteRule ^arbeitsweise/?$ /sis-methode.html [R=301,L,NC]
RewriteRule ^praxis/?$ /praxis.html [R=301,L,NC]
RewriteRule ^buch/?$ /buch.html [R=301,L,NC]
RewriteRule ^kontakt/?$ /kontakt.html [R=301,L,NC]
RewriteRule ^termin/?$ /kontakt.html [R=301,L,NC]
RewriteRule ^sis-methode/?$ /sis-methode.html [R=301,L,NC]
RewriteRule ^angsttherapie/?$ /angsttherapie-duesseldorf.html [R=301,L,NC]
RewriteRule ^paartherapie/?$ /paartherapie-duesseldorf.html [R=301,L,NC]
RewriteRule ^narzissmus/?$ /narzissmus-therapie-duesseldorf.html [R=301,L,NC]
RewriteRule ^hypnose/?$ /hypnose-duesseldorf.html [R=301,L,NC]
RewriteRule ^panikattacken/?$ /panikattacken-hilfe-duesseldorf.html [R=301,L,NC]
RewriteRule ^online-therapie/?$ /online-therapie.html [R=301,L,NC]
RewriteRule ^faq/?$ /faq.html [R=301,L,NC]
RewriteRule ^blog/?$ /blog.html [R=301,L,NC]

# Nachtrag: weitere alte Slugs
RewriteRule ^praxis-duesseldorf/?$ /praxis.html [R=301,L,NC]
RewriteRule ^arbeitsweise-1/?$ /sis-methode.html [R=301,L,NC]
RewriteRule ^termine/?$ /kontakt.html#kontaktformular [R=301,L,NC]
RewriteRule ^methode/?$ /sis-methode.html [R=301,L,NC]
RewriteRule ^sys/?$ /sis-methode.html [R=301,L,NC]
RewriteRule ^burnout/?$ /burnout-therapie-duesseldorf.html [R=301,L,NC]
RewriteRule ^burnout-therapie/?$ /burnout-therapie-duesseldorf.html [R=301,L,NC]

# Buch-Slugs -> Buchseite
RewriteRule ^mein-buch/?$ /buch.html [R=301,L]
RewriteRule ^das-buch/?$ /buch.html [R=301,L]
RewriteRule ^buecher/?$ /buch.html [R=301,L]
RewriteRule ^book/?$ /buch.html [R=301,L]
RewriteRule ^buch-24-stunden-vorspiel/?$ /buch.html [R=301,L]

# Hübsche, on-brand Fehlerseite
ErrorDocument 404 /404.html
